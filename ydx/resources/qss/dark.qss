/* Тёмная тема «тёмная комната»: глубокий холст, слоистые поверхности,
   один жёлтый акцент. Токены — в ydx/ui/theme.py (DARK_COLORS). */

* {
    font-family: "Inter", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QWidget {
    background: #0E0F11;
    color: #EDEEF0;
}

QMainWindow, #centralWrap { background: #0E0F11; }

/* --- Сайдбар --------------------------------------------------------------- */
#sidebar {
    background: #141518;
    border-right: 1px solid #2A2D33;
}
#sidebarTitle {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    color: #71757D;
    padding: 10px 18px 4px 18px;
    background: transparent;
}
QPushButton#navBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 9px 12px;
    text-align: left;
    color: #A6A9B0;
    font-size: 14px;
}
QPushButton#navBtn:hover { background: #1C1E22; color: #EDEEF0; }
QPushButton#navBtn:checked {
    background: rgba(255, 210, 30, 0.12);
    font-weight: 600;
    color: #EDEEF0;
}
#accountBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 6px;
    text-align: left;
}
#accountBtn:hover { background: #1C1E22; }
#accountName {
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#quotaLabel, #quotaFree {
    background: transparent;
    color: #71757D;
    font-size: 12px;
}
#securityWarning {
    background: transparent;
    color: #E5B84B;
    font-size: 11px;
}

/* --- Кнопки ------------------------------------------------------------------ */
QPushButton {
    background: #1C1E22;
    border: 1px solid #2A2D33;
    border-radius: 10px;
    padding: 8px 16px;
    color: #EDEEF0;
}
QPushButton:hover { background: #24262B; border-color: #3A3E46; }
QPushButton:pressed { background: #2B2E34; }
QPushButton:focus { border-color: #FFD21E; }
QPushButton:disabled { color: #575A61; background: #17181B; }
QPushButton[class="primary"] {
    background: #FFD21E;
    border: 1px solid #FFD21E;
    color: #141518;
    font-weight: 600;
}
QPushButton[class="primary"]:hover { background: #FFDC4D; border-color: #FFDC4D; }
QPushButton[class="primary"]:focus { border-color: #EDEEF0; }
QPushButton[class="primary"]:disabled { background: #3A351D; border-color: #3A351D; color: #7A7040; }
QPushButton[class="danger"] { color: #FF6A4D; }
QPushButton[class="danger"]:hover { background: #2A1B16; border-color: #4A2A20; }
QPushButton[class="flat"] { background: transparent; border: none; }
QPushButton[class="flat"]:hover { background: #1C1E22; }
QPushButton[class="icon"] {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 6px;
}
QPushButton[class="icon"]:hover { background: #1C1E22; border-color: #2A2D33; }
QPushButton[class="icon"]:checked { background: #24262B; border-color: #2A2D33; }

/* --- Поля ввода ---------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background: #1C1E22;
    border: 1px solid #2A2D33;
    border-radius: 10px;
    padding: 7px 11px;
    selection-background-color: #FFD21E;
    selection-color: #141518;
    color: #EDEEF0;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #FFD21E; }
QLineEdit:disabled, QComboBox:disabled { background: #17181B; color: #575A61; }
QLineEdit[error="true"] { border-color: #FF6A4D; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #1C1E22;
    border: 1px solid #2A2D33;
    border-radius: 12px;
    selection-background-color: #24262B;
    color: #EDEEF0;
    outline: none;
    padding: 4px;
}

/* --- Чекбоксы и слайдеры --------------------------------------------------------- */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3A3E46;
    border-radius: 5px;
    background: #1C1E22;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #575C66; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #FFD21E;
    border-color: #FFD21E;
}
QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background: #2A2D33;
}
QSlider::sub-page:horizontal { background: #FFD21E; border-radius: 2px; }
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: #EDEEF0;
}
QSlider::handle:horizontal:hover { background: #FFFFFF; }
QSlider::handle:horizontal:disabled { background: #575A61; }

/* --- Прогресс ------------------------------------------------------------------ */
QProgressBar {
    background: #24262B;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk { background: #FFD21E; border-radius: 3px; }
QProgressBar[class="danger"]::chunk { background: #FF6A4D; }

/* --- Меню и тултипы --------------------------------------------------------------- */
QMenu {
    background: #1C1E22;
    border: 1px solid #2A2D33;
    border-radius: 14px;
    padding: 6px;
}
QMenu::item { padding: 7px 26px 7px 14px; border-radius: 9px; color: #EDEEF0; }
QMenu::item:selected { background: #24262B; }
QMenu::item:disabled { color: #575A61; }
QMenu::separator { height: 1px; background: #2A2D33; margin: 5px 8px; }
QToolTip {
    background: #1C1E22;
    color: #EDEEF0;
    border: 1px solid #2A2D33;
    padding: 6px 10px;
    border-radius: 8px;
}

/* --- Списки/таблицы ----------------------------------------------------------------- */
QListView, QTreeView, QTableView {
    background: #0E0F11;
    border: none;
    outline: none;
    alternate-background-color: #111214;
}
QListView::item { border-radius: 8px; }
QListView::item:selected, QTreeView::item:selected {
    background: rgba(255, 210, 30, 0.14);
    color: #EDEEF0;
}
QHeaderView::section {
    background: #0E0F11;
    border: none;
    border-bottom: 1px solid #2A2D33;
    padding: 8px 10px;
    font-weight: 600;
    color: #71757D;
}

/* --- Скроллбары ---------------------------------------------------------------------- */
QScrollBar:vertical { background: transparent; width: 9px; margin: 2px; }
QScrollBar::handle:vertical {
    background: #2B2E34;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #3A3E46; }
QScrollBar:horizontal { background: transparent; height: 9px; margin: 2px; }
QScrollBar::handle:horizontal {
    background: #2B2E34;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover { background: #3A3E46; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* --- Диалоги ------------------------------------------------------------------------ */
QDialog { background: #0E0F11; }
#dialogTitle { font-size: 20px; font-weight: 700; }
#dialogHint { color: #A6A9B0; }
#deviceCode {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 6px;
    color: #EDEEF0;
    background: #1C1E22;
    border: 1px solid #2A2D33;
    border-radius: 14px;
    padding: 18px;
}

/* --- Хлебные крошки -------------------------------------------------------------------- */
#breadcrumbs { background: transparent; }
QPushButton#crumb {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #A6A9B0;
}
QPushButton#crumb:hover { color: #EDEEF0; text-decoration: underline; }
#crumbLast { font-weight: 600; color: #EDEEF0; }

/* --- Панель статуса/ошибок --------------------------------------------------------------- */
#statusChip {
    border-radius: 11px;
    padding: 4px 12px;
    background: #1C1E22;
    border: 1px solid #2A2D33;
    color: #A6A9B0;
}
#errorBanner {
    background: #2A1712;
    color: #FF8E76;
    border: 1px solid #4A2A20;
    border-radius: 12px;
    padding: 10px 14px;
}

/* --- Строки способов входа ---------------------------------------------------- */
QFrame#methodRow {
    background: transparent;
    border: 1px solid #2A2D33;
    border-radius: 14px;
}
QFrame#methodRow:hover { background: #1C1E22; border-color: #FFD21E; }
#methodTitle { background: transparent; font-size: 15px; font-weight: 600; color: #EDEEF0; }
#methodHint { background: transparent; color: #A6A9B0; }
QFrame#methodRow QLabel { background: transparent; }

/* --- Прозрачность контейнеров-обёрток -------------------------------------------- */
#sidebar QWidget, QFrame#methodRow QWidget, #accountBtn QWidget { background: transparent; }

/* --- Нижний баннер синхронизации -------------------------------------------------- */
#syncBanner { background: #1C1E22; border-top: 1px solid #2A2D33; }
#syncBanner QLabel { background: transparent; }
