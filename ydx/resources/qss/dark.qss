/* Тёмная тема — стиль веб-интерфейса Яндекс.Диска */

* {
    font-family: "Inter", "Ubuntu", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

QWidget {
    background: #1E1E21;
    color: #F2F2F4;
}

QMainWindow, #centralWrap { background: #1E1E21; }

/* --- Сайдбар --------------------------------------------------------------- */
#sidebar {
    background: #17171A;
    border-right: 1px solid #2A2A2E;
}
#sidebarTitle {
    font-size: 11px;
    font-weight: 600;
    color: #8A8D94;
    padding: 6px 16px 2px 16px;
    background: transparent;
}
QPushButton#navBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    text-align: left;
    color: #D6D7DB;
    font-size: 14px;
}
QPushButton#navBtn:hover { background: rgba(255, 255, 255, 0.06); }
QPushButton#navBtn:checked {
    background: rgba(255, 255, 255, 0.10);
    font-weight: 600;
    color: #FFFFFF;
}
#accountBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 6px;
    text-align: left;
}
#accountBtn:hover { background: rgba(255, 255, 255, 0.06); }
#accountName {
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
#quotaLabel, #quotaFree {
    background: transparent;
    color: #A3A5AC;
    font-size: 12px;
}
#securityWarning {
    background: transparent;
    color: #E5B84B;
    font-size: 11px;
}

/* --- Кнопки ------------------------------------------------------------------ */
QPushButton {
    background: #2C2C31;
    border: none;
    border-radius: 9px;
    padding: 8px 16px;
    color: #F2F2F4;
}
QPushButton:hover { background: #36363C; }
QPushButton:pressed { background: #3E3E45; }
QPushButton:disabled { color: #7C7E86; }
QPushButton[class="primary"] {
    background: #FFCC00;
    color: #1A1A1A;
    font-weight: 600;
}
QPushButton[class="primary"]:hover { background: #FFDB4D; }
QPushButton[class="primary"]:disabled { background: #5A5040; color: #93876C; }
QPushButton[class="danger"] { color: #FF7A5C; }
QPushButton[class="flat"] { background: transparent; }
QPushButton[class="flat"]:hover { background: rgba(255,255,255,0.06); }
QPushButton[class="icon"] {
    background: transparent;
    border-radius: 8px;
    padding: 6px;
}
QPushButton[class="icon"]:hover { background: rgba(255,255,255,0.08); }
QPushButton[class="icon"]:checked { background: rgba(255,255,255,0.10); }

/* --- Поля ввода ---------------------------------------------------------------- */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox {
    background: #26262B;
    border: 1px solid #3A3A40;
    border-radius: 9px;
    padding: 7px 11px;
    selection-background-color: #FFCC00;
    selection-color: #1A1A1A;
    color: #F2F2F4;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #FFCC00; }
QLineEdit:disabled, QComboBox:disabled { background: #222226; color: #7C7E86; }

QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView {
    background: #26262B;
    border: 1px solid #3A3A40;
    border-radius: 10px;
    selection-background-color: #36363C;
    color: #F2F2F4;
    outline: none;
}

/* --- Прогресс ------------------------------------------------------------------ */
QProgressBar {
    background: #33333A;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}
QProgressBar::chunk { background: #FFCC00; border-radius: 3px; }
QProgressBar[class="danger"]::chunk { background: #FC3F1D; }

/* --- Меню и тултипы --------------------------------------------------------------- */
QMenu {
    background: #26262B;
    border: 1px solid #3A3A40;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item { padding: 7px 26px 7px 14px; border-radius: 8px; color: #F2F2F4; }
QMenu::item:selected { background: #36363C; }
QMenu::separator { height: 1px; background: #33333A; margin: 5px 8px; }
QToolTip {
    background: #F2F2F4;
    color: #1E1E21;
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
}

/* --- Списки/таблицы ----------------------------------------------------------------- */
QListView, QTreeView, QTableView {
    background: #1E1E21;
    border: none;
    outline: none;
}
QListView::item { border-radius: 8px; }
QHeaderView::section {
    background: #1E1E21;
    border: none;
    border-bottom: 1px solid #2A2A2E;
    padding: 8px 10px;
    font-weight: 600;
    color: #A3A5AC;
}

/* --- Скроллбары ---------------------------------------------------------------------- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical {
    background: #3C3C43;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #4A4A52; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #3C3C43; border-radius: 5px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* --- Диалоги ------------------------------------------------------------------------ */
QDialog { background: #1E1E21; }
#dialogTitle { font-size: 18px; font-weight: 700; }
#dialogHint { color: #A3A5AC; }
#deviceCode {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 6px;
    color: #FFFFFF;
    background: #26262B;
    border: 1px solid #3A3A40;
    border-radius: 12px;
    padding: 18px;
}

/* --- Хлебные крошки -------------------------------------------------------------------- */
#breadcrumbs { background: transparent; }
QPushButton#crumb {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #A3A5AC;
}
QPushButton#crumb:hover { color: #FFFFFF; text-decoration: underline; }
#crumbLast { font-weight: 600; }

/* --- Панель статуса/ошибок --------------------------------------------------------------- */
#statusChip {
    border-radius: 10px;
    padding: 4px 12px;
    background: #2C2C31;
    color: #A3A5AC;
}
#errorBanner {
    background: #42221A;
    color: #FFA88F;
    border-radius: 10px;
    padding: 10px 14px;
}

/* --- Строки способов входа ---------------------------------------------------- */
QFrame#methodRow {
    background: transparent;
    border: 1px solid #33333A;
    border-radius: 12px;
}
QFrame#methodRow:hover { background: rgba(255,255,255,0.05); border-color: #FFCC00; }
#methodTitle { background: transparent; font-size: 15px; font-weight: 600; color: #F2F2F4; }
#methodHint { background: transparent; color: #A3A5AC; }
QFrame#methodRow QLabel { background: transparent; }

/* --- Прозрачность контейнеров-обёрток -------------------------------------------- */
#sidebar QWidget, QFrame#methodRow QWidget, #accountBtn QWidget { background: transparent; }

/* --- Нижний баннер синхронизации -------------------------------------------------- */
#syncBanner { background: #2E2A1E; border-top: 1px solid #4A4230; }
#syncBanner QLabel { background: transparent; }
